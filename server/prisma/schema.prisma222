generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model admin_users {
  id         String   @id @db.Char(36)
  user_id    String   @unique @db.Char(36)
  email      String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.DateTime(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model attendance {
  id               String            @id @db.Char(36)
  student_id       String            @db.Char(36)
  status           attendance_status @default(pending)
  created_at       DateTime          @default(now()) @db.DateTime(0)
  attendance_date  DateTime          @db.Date
  check_in_time    DateTime?         @db.DateTime(0)
  check_out_time   DateTime?         @db.DateTime(0)
  class_session_id String?           @db.Char(36)
  notes            String?           @db.VarChar(512)
  source           String            @default("student") @db.VarChar(32)
  updated_at       DateTime          @db.DateTime(0)
  validated_at     DateTime?         @db.DateTime(0)
  validated_by     String?           @db.Char(36)
  class_sessions   class_sessions?   @relation(fields: [class_session_id], references: [id])
  students         students          @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([attendance_date])
  @@index([class_session_id])
  @@index([status])
  @@index([student_id])
}

model belt_rank_history {
  id                    String    @id @db.Char(36)
  student_id            String    @db.Char(36)
  belt_name             String    @db.VarChar(64)
  rank_label            String?   @db.VarChar(64)
  stripe_level          Int?
  grading_date          DateTime? @db.DateTime(0)
  next_eligibility_date DateTime? @db.DateTime(0)
  grading_score         String?   @db.VarChar(64)
  remarks               String?   @db.VarChar(512)
  updated_by            String?   @db.Char(36)
  created_at            DateTime  @default(now()) @db.DateTime(0)
  students              students  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([grading_date])
  @@index([student_id])
}

model class_sessions {
  id                 String                     @id @db.Char(36)
  title              String                     @db.VarChar(255)
  class_type         String?                    @db.VarChar(64)
  training_center_id String?                    @db.Char(36)
  instructor_name    String?                    @db.VarChar(255)
  discipline         class_sessions_discipline?
  session_date       DateTime                   @db.Date
  start_time         DateTime?                  @db.DateTime(0)
  end_time           DateTime?                  @db.DateTime(0)
  status             class_sessions_status      @default(scheduled)
  notes              String?                    @db.VarChar(512)
  created_at         DateTime                   @default(now()) @db.DateTime(0)
  updated_at         DateTime                   @db.DateTime(0)
  instructor_id      String?                    @db.Char(36)
  attendance         attendance[]
  instructors        instructors?               @relation(fields: [instructor_id], references: [id])
  training_centers   training_centers?          @relation(fields: [training_center_id], references: [id])

  @@index([instructor_id], map: "class_sessions_instructor_id_fkey")
  @@index([session_date])
  @@index([status])
  @@index([training_center_id])
}

model instructor_student_assignments {
  id                  String      @id @db.Char(36)
  instructor_id       String      @db.Char(36)
  student_id          String      @db.Char(36)
  assigned_at         DateTime    @default(now()) @db.DateTime(0)
  assigned_by_user_id String?     @db.Char(36)
  created_at          DateTime    @default(now()) @db.DateTime(0)
  updated_at          DateTime    @db.DateTime(0)
  instructors         instructors @relation(fields: [instructor_id], references: [id], onDelete: Cascade)
  students            students    @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([instructor_id, student_id])
  @@index([instructor_id])
  @@index([student_id])
}

model instructors {
  id                             String                           @id @db.Char(36)
  user_id                        String                           @unique @db.Char(36)
  full_name                      String                           @db.VarChar(255)
  email                          String                           @db.VarChar(255)
  phone                          String?                          @db.VarChar(32)
  bio                            String?                          @db.VarChar(512)
  city                           String?                          @db.VarChar(128)
  state                          String?                          @db.VarChar(128)
  profile_photo_url              String?                          @db.VarChar(512)
  is_active                      Boolean                          @default(true)
  can_login                      Boolean                          @default(true)
  created_at                     DateTime                         @default(now()) @db.DateTime(0)
  updated_at                     DateTime                         @db.DateTime(0)
  class_sessions                 class_sessions[]
  instructor_student_assignments instructor_student_assignments[]
  users                          users                            @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model pincode_lookups {
  pincode    String   @id @db.VarChar(16)
  city       String   @db.VarChar(128)
  state      String   @db.VarChar(128)
  created_at DateTime @default(now()) @db.DateTime(0)
}

model refresh_tokens {
  id         String   @id @db.Char(36)
  user_id    String   @db.Char(36)
  token_hash String   @db.VarChar(255)
  expires_at DateTime @db.DateTime(0)
  created_at DateTime @default(now()) @db.DateTime(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token_hash])
  @@index([user_id])
}

model roles {
  id         String       @id @db.Char(36)
  name       String       @unique @db.VarChar(64)
  user_roles user_roles[]
}

model student_grading_progress {
  id                          String    @id @db.Char(36)
  student_id                  String    @unique @db.Char(36)
  syllabus_completion_percent Int       @default(0)
  mock_review_status          String?   @db.VarChar(64)
  readiness_status            String?   @db.VarChar(64)
  attendance_eligibility      Boolean   @default(false)
  instructor_notes            String?   @db.VarChar(512)
  reviewed_by_instructor_id   String?   @db.Char(36)
  reviewed_at                 DateTime? @db.DateTime(0)
  created_at                  DateTime  @default(now()) @db.DateTime(0)
  updated_at                  DateTime  @db.DateTime(0)
  students                    students  @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model students {
  id                                 String                           @id @db.Char(36)
  user_id                            String?                          @unique @db.Char(36)
  full_name                          String                           @db.VarChar(255)
  email                              String                           @db.VarChar(255)
  phone                              String?                          @db.VarChar(32)
  date_of_birth                      DateTime?                        @db.Date
  gender                             students_gender?
  blood_group                        String?                          @db.VarChar(16)
  emergency_contact                  String?                          @db.VarChar(128)
  parent_guardian_name               String?                          @db.VarChar(255)
  aadhar_number                      String?                          @db.VarChar(32)
  qualification                      String?                          @db.VarChar(128)
  address                            String?                          @db.VarChar(512)
  pincode                            String?                          @db.VarChar(16)
  city                               String?                          @db.VarChar(128)
  state                              String?                          @db.VarChar(128)
  locality                           String?                          @db.VarChar(128)
  school_college_name                String?                          @db.VarChar(255)
  school_college_location_city       String?                          @db.VarChar(128)
  school_college_location_state      String?                          @db.VarChar(128)
  school_college_location_pin        String?                          @db.VarChar(16)
  instructor_name                    String?                          @db.VarChar(255)
  preferred_discipline               students_preferred_discipline?
  training_center_id                 String?                          @db.Char(36)
  profile_photo_url                  String?                          @db.VarChar(512)
  status                             students_status                  @default(pending)
  marketing_opt_in                   Boolean                          @default(false)
  terms_accepted_at                  DateTime?                        @db.DateTime(0)
  validated_at                       DateTime?                        @db.DateTime(0)
  validated_by                       String?                          @db.Char(36)
  registration_id                    String?                          @unique @db.VarChar(32)
  enrollment_id                      String?                          @unique @db.VarChar(64)
  created_at                         DateTime                         @default(now()) @db.DateTime(0)
  updated_at                         DateTime                         @db.DateTime(0)
  current_belt                       String?                          @db.VarChar(64)
  current_rank_label                 String?                          @db.VarChar(64)
  current_stripe_level               Int?
  next_grading_date                  DateTime?                        @db.DateTime(0)
  attendance                         attendance[]
  belt_rank_history                  belt_rank_history[]
  instructor_student_assignments     instructor_student_assignments[]
  student_grading_progress           student_grading_progress?
  training_centers                   training_centers?                @relation(fields: [training_center_id], references: [id])
  users_students_user_idTousers      users?                           @relation("students_user_idTousers", fields: [user_id], references: [id])
  users_students_validated_byTousers users?                           @relation("students_validated_byTousers", fields: [validated_by], references: [id])

  @@index([created_at])
  @@index([email])
  @@index([status])
  @@index([training_center_id], map: "students_training_center_id_fkey")
  @@index([user_id])
  @@index([validated_by], map: "students_validated_by_fkey")
}

model training_centers {
  id             String           @id @db.Char(36)
  slug           String           @unique @db.VarChar(64)
  name           String           @db.VarChar(255)
  address        String?          @db.VarChar(512)
  city           String?          @db.VarChar(128)
  state          String?          @db.VarChar(128)
  created_at     DateTime         @default(now()) @db.DateTime(0)
  pincode        String?          @db.VarChar(16)
  class_sessions class_sessions[]
  students       students[]
}

model user_roles {
  user_id String @db.Char(36)
  role_id String @db.Char(36)
  roles   roles  @relation(fields: [role_id], references: [id], onDelete: Cascade)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([role_id], map: "idx_user_roles_role_id")
}

model users {
  id                                    String           @id @db.Char(36)
  email                                 String           @unique @db.VarChar(255)
  password_hash                         String?          @db.VarChar(255)
  email_verified_at                     DateTime?        @db.DateTime(0)
  created_at                            DateTime         @default(now()) @db.DateTime(0)
  updated_at                            DateTime         @db.DateTime(0)
  admin_users                           admin_users?
  instructors                           instructors?
  refresh_tokens                        refresh_tokens[]
  students_students_user_idTousers      students?        @relation("students_user_idTousers")
  students_students_validated_byTousers students[]       @relation("students_validated_byTousers")
  user_roles                            user_roles[]
}

enum attendance_status {
  pending
  approved
  rejected
}

enum class_sessions_discipline {
  karate_shotokan
  judo_kodokan
  self_defense
}

enum students_gender {
  male
  female
  other
}

enum class_sessions_status {
  scheduled
  completed
  cancelled
  rescheduled
}

enum students_preferred_discipline {
  karate_shotokan
  judo_kodokan
  self_defense
}

enum students_status {
  draft
  pending
  approved
  paused
  rejected
}
