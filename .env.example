# ------------------------------------------------------------
# MyDojo environment template
# Copy this file to .env.local for local development or .env.production
# on the production host. Never commit either file.
# Never commit real .env files or real secrets.
# ------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# App base path
APP_BASE_PATH=/
VITE_APP_BASE_PATH=/

# Database
# Production example:
# DATABASE_URL="mysql://DB_USER:DB_PASSWORD@66.116.232.151:3306/mdpl_db"
#
# Local example:
# DATABASE_URL="mysql://root:YOUR_URL_ENCODED_PASSWORD@localhost:3306/mdpl_db_dev"
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/mdpl_db"
DB_CONNECTION_LIMIT=5

# API runtime paths. Relative paths are resolved from mdpl-api/.
UPLOAD_DIR=uploads
PM2_LOG_DIR=logs
PM2_APP_NAME=mdpl-api

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Auth / JWT
JWT_ACCESS_SECRET=change_me_min_32_chars
JWT_REFRESH_SECRET=change_me_min_32_chars
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=7

# Cookies
# Use false for local HTTP.
# Use true for production HTTPS.
COOKIE_SECURE=false

# CORS
# Local:
# CORS_ORIGIN="http://localhost:3000"
#
# Production:
# CORS_ORIGIN="https://uk.primewayz.com,http://localhost:3000,https://kreatorbox.com"
CORS_ORIGIN="http://localhost:3000"

# SMTP / Email
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mydojo.pvt.ltd@gmail.com
# Use a Google Account app password, never the normal Gmail password.
SMTP_PASS=
EMAIL_FROM="MyDojo <mydojo.pvt.ltd@gmail.com>"
ADMIN_NOTIFICATION_EMAIL=mydojo.pvt.ltd@gmail.com

# Server-side chat provider, OpenAI-compatible endpoint
CHAT_API_KEY=
CHAT_API_BASE=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini


# Google Analytics 4
VITE_GA_MEASUREMENT_ID=
