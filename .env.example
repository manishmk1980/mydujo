# ----- Client (optional; set before npm run build for production) -----
# VITE_API_URL="https://api.yourdomain.com"
# Canonical URLs for SEO (prerender + <Seo />). Defaults: kreatorbox.com + /mdpl-qa
# VITE_PUBLIC_SITE_ORIGIN="https://kreatorbox.com"
# VITE_PUBLIC_BASE_PATH="/mdpl-qa"

# ----- Server / Database -----
# Optional: admin dashboard “active in portal” window (minutes). Default 15.
# PORTAL_ACTIVITY_WINDOW_MINUTES=15
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/mdpl_db_qa"
# PORT=4000
# NODE_ENV=production
# CORS_ORIGIN="https://yourdomain.com"
# JWT_ACCESS_SECRET=your-secret-min-32-chars    
# JWT_REFRESH_SECRET=another-secret-min-32-chars
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE=true
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# ----- Client (Gemini, etc.) -----
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
